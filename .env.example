# --- Turso (hosted SQLite) -------------------------------------------------
# Sign up at https://turso.tech (free, no card), create a database, then
# generate a Group/Database token under the database's "Tokens" tab.
TURSO_DATABASE_URL=libsql://your-db.turso.io
TURSO_AUTH_TOKEN=your-rw-token-here

# --- Blocket API -----------------------------------------------------------
# Base URL for the unofficial Blocket API. Leave as-is unless self-hosting
# a mirror.
BLOCKET_API_BASE=https://blocket-api.se

# --- Sync token ------------------------------------------------------------
# Bearer token guarding POST /api/sync. Only needed if you want to trigger
# syncs over HTTP (the GitHub Actions cron uses TURSO_* directly and skips
# this). Generate in production: `openssl rand -hex 32`.
SYNC_TOKEN=change-me-to-a-random-string
