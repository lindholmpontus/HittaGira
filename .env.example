# --- Turso (hosted SQLite) -------------------------------------------------
# Sign up at https://turso.tech (free, no card), create a database, then
# generate a Group/Database token under the database's "Tokens" tab.
TURSO_DATABASE_URL=libsql://your-db.turso.io
TURSO_AUTH_TOKEN=your-rw-token-here

# --- Blocket API -----------------------------------------------------------
# Base URL for the unofficial Blocket API. Leave as-is unless self-hosting
# a mirror.
BLOCKET_API_BASE=https://blocket-api.se

# --- Sync token ------------------------------------------------------------
# Bearer token guarding POST /api/sync. Only needed if you want to trigger
# syncs over HTTP (the GitHub Actions cron uses TURSO_* directly and skips
# this). Generate in production: `openssl rand -hex 32`.
SYNC_TOKEN=change-me-to-a-random-string

# --- Visitor statistics ----------------------------------------------------
# Key for the private dashboard: open /statistik?key=<STATS_TOKEN>.
# Without it set, /statistik always 404s. `openssl rand -hex 32`.
STATS_TOKEN=change-me-to-a-random-string
# Secret mixed into the daily visitor hash so hashes can't be reversed into
# IP addresses. Any random string; changing it only resets today's uniques.
ANALYTICS_SALT=change-me-to-a-random-string

# --- Donations (the "Stöd" page) -------------------------------------------
# Your Swish number, e.g. 0701234567. Leave empty to hide Swish. Kept in env
# rather than in the code so it never ends up in the git history. The page
# is static, so a change shows up on the next deploy.
SWISH_NUMBER=

# --- Feedback form (/kontakt) ------------------------------------------------
# Messages are emailed via Resend (https://resend.com, free tier). Sign up with
# the same address as CONTACT_EMAIL, then create an API key under "API Keys".
RESEND_API_KEY=
CONTACT_EMAIL=
