# --- Database --------------------------------------------------------------
# Path to the SQLite database file. Use the `file:` prefix.
# In production with a mounted volume (e.g. Fly.io), point at the volume:
#   DATABASE_URL=file:/data/hittagira.db
DATABASE_URL=file:./data/hittagira.db

# --- Blocket API -----------------------------------------------------------
# Base URL for the unofficial Blocket API. Leave as-is unless you self-host
# a mirror.
BLOCKET_API_BASE=https://blocket-api.se

# --- Sync token ------------------------------------------------------------
# Bearer token required to call POST /api/sync. Generate a random string for
# production (e.g. `openssl rand -hex 32`). NEVER commit the real value.
SYNC_TOKEN=change-me-to-a-random-string
